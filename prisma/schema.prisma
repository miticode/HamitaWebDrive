generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Gallery {
  id         String  @id @default(cuid())
  slug       String  @unique
  title      String
  clientName String?
  /// Loi nhan studio gui rieng cho khach nay. Bo trong thi dung loi chuc chung.
  message    String?
  /// Cho phep hien anh bia cua album nay tren trang gioi thieu cong khai.
  featured   Boolean @default(false)

  /// Album nay thuoc mang chup be (Hami Baby) chu khong phai mang cuoi.
  /// Chi co y nghia khi featured bat: quyet dinh anh bia roi vao khu "Mot vai
  /// bo anh" (cuoi) hay khu Hami Baby tren trang gioi thieu. Mac dinh false vi
  /// phan lon album cua studio la anh cuoi.
  /// KHONG CON DUNG — thay bang cot khuGioiThieu. Giu lai de khong phai xoa
  /// cot (thao tac khong lui duoc), giong cach da lam voi accessMode.
  laBaby       Boolean @default(false)
  /// KHONG CON DUNG — thay bang cot khuGioiThieu. Xem chu thich o laBaby.
  laPhimTruong Boolean @default(false)

  /// Album nay hien o KHU NAO tren trang gioi thieu.
  ///
  /// Nhan mot trong bon gia tri: "cuoi" | "albumhc" | "phimtruong" | "baby".
  /// Chi co y nghia khi featured bat.
  ///
  /// Vi sao mot cot chu thay vi nhieu cot dung/sai: bon khu LOAI TRU NHAU, ma
  /// ba cot dung/sai sinh ra tam to hop trong do bon cai vo nghia ("vua la be
  /// vua la phim truong"). Mot cot chu thi trang thai vo nghia khong ton tai.
  ///
  /// Hai khu doc du lieu theo hai kieu khac han nhau:
  /// - "cuoi", "albumhc", "baby": moi album gop dung MOT ANH BIA vao luoi
  ///   chung, vi moi album la buoi chup cua mot nha khach.
  /// - "phimtruong": chi mot album duy nhat, va doc THANG nhieu anh tu trong
  ///   no ra — day la boi canh cua studio, mot tam bia khong khoe duoc gi.
  ///   Bat cho album thu hai thi album do bi bo qua (xem src/app/page.tsx).
  khuGioiThieu String @default("cuoi")

  driveFolderId String
  allowDownload Boolean  @default(true)
  createdAt     DateTime @default(now())

  /// KHONG CON DUNG. Truoc day co ba che do truy cap; gio chi con mot cach duy
  /// nhat la "xem tu do, can ma de chon anh". Giu lai cot de khong phai xoa du
  /// lieu trong database — xoa cot khong loi gi ma lai la thao tac khong lui duoc.
  accessMode String @default("SELECT")

  /// Ma khach nhap de chon anh. Luu dang doc duoc vi trang quan tri phai hien
  /// cho anh doc lai cho khach — day la ma chon anh, khong phai mat khau tai khoan.
  accessCode String?

  /// So lieu chup lai tu Drive luc tao link va moi lan bam "Lam moi".
  /// Luu san de trang quan tri khong phai duyet cay thu muc cua tung album —
  /// 9 album la khoang 70 lan goi Drive, cham 8-10 giay moi lan mo trang.
  coverFileId String?
  /// true khi anh tu chon anh bia — luc do lan dong bo sau khong duoc ghi de.
  coverPinned Boolean  @default(false)
  photoCount  Int      @default(0)
  albumCount  Int      @default(0)
  subfolders  String[]

  /// Tong dung luong anh cua album tren Drive, tinh bang MEGABYTE.
  ///
  /// Chup lai cung luc voi photoCount: cung mot lan doc cay thu muc da co san
  /// kich thuoc tung tep, nen khong ton them lan goi Drive nao. Nho vay trang
  /// quan ly cong duoc "don album nay giai phong bao nhieu" ma van khong goi
  /// Drive (nguyen tac 9).
  ///
  /// Don vi MB chu khong phai byte: mot album 2,58 GB tinh bang byte se vuot
  /// tran kieu Int, ma doi sang BigInt thi keo theo rac roi luc chuyen so qua
  /// JSON. MB du chinh xac cho viec quyet dinh don album nao truoc.
  ///
  /// 0 nghia la CHUA DO chu khong phai album rong — album tao truoc 26/08/2026
  /// mang gia tri nay cho toi lan "Lam moi" ke tiep.
  dungLuongMB Int @default(0)

  /// So lan khach mo trang bia cua album.
  ///
  /// Chi dem, KHONG luu ai xem hay xem tu dau — studio khong can biet dieu do,
  /// va khong thu thap thi khong phai giu gin.
  ///
  /// Muc dich that su khong phai bang xep hang cho vui, ma la tra loi mot cau
  /// hoi co viec de lam: "link gui ba ngay roi ma khach chua mo lan nao" thi
  /// studio nhac mot tieng. Truoc day khong co cach nao biet.
  ///
  /// 0 co the nghia la CHUA AI MO, ma cung co the la album tao truoc ngay
  /// 26/08/2026 — luc do chua co cot nay. Trang thong ke phai phan biet bang
  /// ngay tao, dung ket luan la khach bo be.
  luotXem    Int       @default(0)
  xemLanDau  DateTime?
  xemLanCuoi DateTime?

  /// So TAM ANH khach da tai ve tu album nay.
  ///
  /// Dem theo TAM, khong theo luot bam: nut "Tai ca thu muc" tai tung tam mot
  /// qua cung mot duong, nen dem luot bam se ra mot con so vo nghia — mot lan
  /// bam co the la 600 tam.
  ///
  /// Muc dich: tra loi "khach da lay anh ve chua". Album da het han giu anh ma
  /// khach chua tai tam nao thi studio con phai nhac; tai het roi thi don Drive
  /// duoc yen tam. Truoc day khong co cach nao biet.
  ///
  /// Chi dem, KHONG luu ai tai hay tai tam nao — cung ly do voi luotXem.
  ///
  /// 0 co the nghia la CHUA AI TAI, ma cung co the la album tao truoc ngay
  /// 06/09/2026 (luc do chua co cot nay). Phan biet bang MOC_DEM_LUOT_TAI.
  luotTai    Int       @default(0)
  taiLanCuoi DateTime?

  syncedAt DateTime?

  /// Moc studio du dinh xoa anh khoi Drive. Khach thay dem nguoc de tranh thu
  /// tai ve. Chi la loi nhac — het han khong tu chan link, vi anh nam tren Drive.
  expiresAt DateTime?

  /// Khach tu bao "da chon xong anh" luc nao — null nghia la chua bao. Ap dung
  /// cho ca gallery (moi thu muc con dung chung mot danh sach chon) nen khong
  /// gan vao tung thu muc rieng.
  selectionsDoneAt DateTime?

  /// So anh in da bao gom trong goi khach da mua. null = khong noi toi goi
  /// (phan huong dan se bo qua doan gia ca). Moi goi moi khac nen phai dat
  /// rieng cho tung album.
  soAnhTrongGoi Int?

  /// Gia moi tam vuot goi, tinh bang dong. Anh chot 01/10/2026: 15.000d, va
  /// cau "bao gom ca chinh sua va in" QUAY LAI moi cho khach doc — dao nguoc
  /// dung quyet dinh 27/09/2026 (ha xuong 10.000d, bo han cum do).
  /// Chi co y nghia khi soAnhTrongGoi co gia tri.
  giaAnhThem Int @default(15000)

  /// Hop dong cua nha khach nay (dot 2b, 16/09/2026) — nhan vien tu gan o
  /// trang album. AppSheet khong biet gi ve album nen day la du lieu CUA WEB:
  /// bo dong bo dem khong bao gio dung toi cot nay.
  hopDongId String?
  hopDong   HopDong? @relation(fields: [hopDongId], references: [id], onDelete: SetNull)

  lists        SelectionList[]
  pushSubs     PushSub[]
  mucXong      MucXong[]
  moMuc        MoMuc[]
  biaMuc       BiaMuc[]
  goiMuc       GoiMuc[]
  anhGioiThieu AnhGioiThieu[]

  @@index([driveFolderId])
  @@index([hopDongId])
}

/// Khach da bao "chon xong" cho MOT thu muc con.
///
/// Truoc day trang thai nay la mot cot tren Gallery, tuc la chung ca album:
/// khach chon xong thu muc dau roi sang thu muc thu hai thi cho nao cung hien
/// "da bao xong", trong khi thu muc thu hai ho chua dong vao. Moi thu muc mot
/// dong o day thi tinh rieng duoc.
///
/// Giu ca ten thu muc luc bao, de thong bao ve studio noi ro duoc khach vua
/// chon xong o dau — va van doc duoc ke ca khi sau do thu muc bi doi ten tren
/// Drive.
/// Lan DAU TIEN khach mo mot thu muc con — anh yeu cau 28/09/2026.
///
/// Studio up anh xong bam "gui thong bao", roi ngoi doi khong biet khach da mo
/// ra xem chua. Truoc day web khong ghi gi ca: chi biet khach da mo KHI ho bat
/// thong bao hoac tha tim — ma ca hai deu den muon hon nhieu, con nguoi xem
/// roi de do thi khong de lai dau vet nao.
///
/// CHI GHI LAN DAU (anh chot): khoa khong trung theo (galleryId, albumId) va
/// ghi bang createMany skipDuplicates — lan mo thu hai tro di khong dong nao
/// thay doi, nen "luc" luon la lan dau that.
///
/// KHONG ghi luot cua studio: nguoi trong tiem hay mo link kiem tra, ghi ca
/// vao thi the nao cung bao "khach da xem" trong khi khach chua he mo.
model MoMuc {
  id        String   @id @default(cuid())
  galleryId String
  /// Ma thu muc con. Chuoi rong = anh nam ngay thu muc goc.
  albumId   String
  /// Ten thu muc doc tu Drive luc khach mo — de log con doc duoc ca khi sau
  /// nay thu muc bi doi ten hoac xoa.
  tenMuc    String
  luc       DateTime @default(now())

  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@unique([galleryId, albumId])
  @@index([galleryId])
}

model MucXong {
  id        String   @id @default(cuid())
  galleryId String
  /// Ma thu muc con. Chuoi rong nghia la anh nam ngay thu muc goc.
  albumId   String
  tenMuc    String
  xongLuc   DateTime @default(now())
  /// Khach bao gi: "xong" = duyet xong, cho in; "can-sua" = xem roi nhung
  /// muon Media chinh lai (anh yeu cau 08/10/2026).
  ///
  /// Mot thu muc chi mang MOT trang thai — khoa khong trung (galleryId,
  /// albumId) van giu nguyen. Khach bam nut khac thi dong cu doi loai, khong
  /// sinh dong thu hai, nen khong bao gio co canh vua "xong" vua "can sua".
  ///
  /// Mac dinh "xong" de moi dong da co truoc 08/10/2026 giu dung y nghia cu.
  loai      String   @default("xong")

  /// NGAY KHACH CAN LAY HINH, chi hoi o thu muc file goc hinh cong / album
  /// (anh yeu cau 05/11/2026) — xem `laMucHoiHanLay` trong constants.ts.
  ///
  /// null co HAI nghia khac nhau, va deu hop le:
  ///   - thu muc khong thuoc dien hoi ngay (file goc nha gai, hoan thien...)
  ///   - khach duoc hoi nhung bam "chua biet, de Hamita chu dong"
  /// Media doc nhan tren the album: co ngay thi hien han, khong thi im.
  ///
  /// Luu dang DateTime nhung CHI DUNG PHAN NGAY (dat 00:00 gio studio). Khach
  /// hen "ngay 20" chu khong hen "10 gio sang ngay 20".
  hanLay DateTime?

  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@unique([galleryId, albumId])
  @@index([galleryId])
}

/// Mot may khach da dong y nhan thong bao day ve cho album nay.
///
/// Moi may mot dong: co dau chu re moi nguoi mot dien thoai, va cung mot nguoi
/// co the vua cai tren dien thoai vua cai tren may tinh. Xoa album thi xoa
/// theo (onDelete: Cascade) — khong con anh thi khong con gi de bao.
model PushSub {
  id        String @id @default(cuid())
  galleryId String

  /// Dia chi rieng cua may khach do ben dich vu day tin cua trinh duyet.
  /// Unique de mot may dang ky lai nhieu lan khong sinh ra nhieu dong.
  endpoint String @unique
  /// Hai khoa de ma hoa noi dung, dich vu day tin khong doc duoc tin nhan.
  p256dh   String
  auth     String

  createdAt DateTime @default(now())

  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@index([galleryId])
}

/// Moi gallery co nhieu danh sach chon (mac dinh: "Anh in" va "Anh chon").
/// Tach thanh bang rieng de sau nay them loai moi ma khong phai sua schema.
/// Anh bia rieng cho MOT thu muc con, do studio tu chon.
///
/// Vi sao la bang rieng chu khong phai mot cot trong Gallery: thu muc con
/// KHONG co ban ghi nao trong database ca — danh sach thu muc doc thang tu
/// Drive moi lan khach mo trang (nguyen tac 4). Muon gan them thu gi cho mot
/// thu muc thi phai co bang tro toi no bang albumId, dung cach MucXong da lam.
///
/// Khong co dong nao cho mot thu muc = dung tam dau tien lam bia, nhu truoc.
model BiaMuc {
  id        String @id @default(cuid())
  galleryId String
  /// Ma thu muc con tren Drive. Chuoi rong nghia la anh nam ngay thu muc goc.
  albumId   String
  /// Ma tam anh duoc chon lam bia.
  fileId    String

  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@unique([galleryId, albumId])
  @@index([galleryId])
}

/// So anh trong goi cua RIENG mot thu muc con.
///
/// Vi sao can: mot nha khach co the chup lam nhieu dot cach nhau ca thang —
/// chup cong truoc, it lau sau moi chup cuoi — va moi dot la mot goi rieng voi
/// so tam in khac nhau. Truoc day ca album chi co MOT con so (Gallery.
/// soAnhTrongGoi), nen dot thu hai bat buoc phai dung chung goi cua dot dau.
///
/// KHONG co dong nao cho mot thu muc = thu muc do dung con so chung cua album.
/// Nho vay phan lon album (chi mot goi duy nhat) khong sinh them dong nao ca,
/// va studio khong phai dat lai tung thu muc mot.
///
/// Chi luu SO TAM, khong luu gia: gia moi tam vuot goi la con so co dinh cua
/// studio, giong nhau o moi goi (xem GoiAnh.tsx).
///
/// Giu ca ten thu muc luc dat — cung ly do voi MucXong: don giao in gom anh
/// theo TEN thu muc (Selection.albumName) chu khong theo ma, ma trang do khong
/// duoc goi Drive de tra ma ra ten (nguyen tac 9).
model GoiMuc {
  id        String @id @default(cuid())
  galleryId String
  /// Ma thu muc con. Chuoi rong nghia la anh nam ngay thu muc goc.
  albumId   String
  tenMuc    String
  /// So anh in co san trong goi cua rieng thu muc nay. 0 = goi chi lay file.
  soAnh     Int

  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@unique([galleryId, albumId])
  @@index([galleryId])
}

model SelectionList {
  id        String @id @default(cuid())
  galleryId String
  name      String
  icon      String @default("heart")
  position  Int    @default(0)

  gallery    Gallery     @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  selections Selection[]

  @@index([galleryId, position])
}

/// Anh khong duoc luu vao database — danh sach anh doc thang tu Drive moi lan
/// xem, de anh tha them folder moi vao Drive la khach thay ngay. O day chi luu
/// ID va ten file, kem ten album, de xuat danh sach duoc ngay ca khi anh bi go
/// khoi Drive.
model Selection {
  id          String   @id @default(cuid())
  listId      String
  driveFileId String
  fileName    String
  albumName   String
  /// Ma an danh sinh o trinh duyet khach, khong can dang nhap.
  visitorId   String
  note        String?
  createdAt   DateTime @default(now())

  list SelectionList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, driveFileId, visitorId])
  @@index([listId])
}

/// Moc thoi gian cua nhung viec dinh ky studio lam bang tay, moi viec mot dong.
///
/// Hien chi dung mot khoa: "saoLuu" — lan bam nut "Sao luu ngay" gan nhat.
/// Khong co dong nay thi nut chi la mot cai nut bam roi quen; co no thi trang
/// quan ly noi duoc "lan cuoi cach day 12 ngay", ma do moi la thu nhac studio
/// sao luu tiep. Chinh cai thieu loi nhac la ly do Drive day 99,5% ma khong ai
/// biet — dung bai hoc do cho o day luon.
model Moc {
  ten String   @id
  luc DateTime @default(now())
}

/// Ghi lai cac lan dang nhap sai de chan do mat khau.
/// Phai luu o database chu khong phai trong bo nho: tren Vercel moi request co
/// the roi vao mot may khac nhau, dem trong bo nho se bi reset lien tuc.
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

/// Ket noi Google Drive bang chinh tai khoan chu studio.
/// Co ban ghi nay thi web doc Drive duoi danh nghia chu tai khoan (khong can
/// share folder cho ai); khong co thi quay ve dung service account.
/// Chi giu mot ban ghi duy nhat — id luon la "default".
model GoogleAccount {
  id           String   @id @default("default")
  email        String
  refreshToken String
  connectedAt  DateTime @default(now())
}

/// Nhan vien cua studio — nguoi dang nhap vao phan quan ly studio (/quan-ly).
///
/// Dang nhap bang TEN DANG NHAP + MAT KHAU (studio chot 15/09/2026, thay cho
/// dang nhap Google — cho don gian). Mac dinh ten dang nhap la so dien thoai,
/// vi nhan vien nao cung nho so cua minh.
///
/// KHONG lay lai mat khau ben AppSheet cu: o do mat khau nam tran trong file
/// Google Sheet dung ten nguoi ban app, 25/26 cai chinh la so dien thoai cua
/// nguoi do. Quan ly cap mat khau tam, nhan vien doi ngay lan dau dang nhap.
model NhanVien {
  id          String    @id @default(cuid())
  /// Ma nhan vien ben AppSheet cu — de ghep du lieu khi chuyen cac bang sau
  /// (cham cong, luong). null voi nhan vien tao moi tren web.
  maNV        String?   @unique
  ten         String
  /// Viet thuong, khong dau cach. Mac dinh la so dien thoai.
  tenDangNhap String    @unique
  /// Mat khau da bam bang scrypt (src/lib/matKhau.ts). null = chua duoc cap,
  /// chua dang nhap duoc. KHONG BAO GIO luu mat khau doc duoc.
  matKhau     String?
  /// true = phai doi mat khau o lan dang nhap toi (vua duoc cap mat khau tam).
  doiMatKhau  Boolean   @default(true)
  /// "quan-tri" | "sale" | "nhan-vien" — xem VAI_TRO trong nhanVienChung.ts.
  /// Sua hop dong: quan tri + sale. Duyet thu chi: chi quan tri. Xem luong:
  /// quan tri xem moi nguoi, con lai chi xem cua minh (studio chot 15/09/2026).
  vaiTro      String    @default("nhan-vien")
  soDienThoai String?
  email       String?
  gioiTinh    String?
  /// "Nhân viên" | "Cộng tác viên" — giu nguyen chu nhu ben AppSheet.
  loaiNV      String?
  phongBan    String?
  chucVu      String?
  ngayVaoLam  DateTime?
  /// Luong cung moi thang, dong. Them 13/11/2026 (dot 5).
  ///
  /// Dot 1 CO Y khong nhap cot nay tu AppSheet vi nhay cam. Nay bang luong can
  /// no. CHI QUAN LY duoc doc — xem src/lib/luong.ts.
  ///
  /// De trong thi may tinh luong lay luong cung cua KY GAN NHAT trong bang
  /// LuongNhanVien, nen khong phai go lai 25 nguoi moi chay duoc.
  luongCung   Int?
  /// false = da nghi viec: khong dang nhap duoc nua, moi phien bi xoa.
  dangLam     Boolean   @default(true)
  dangNhapLuc DateTime?

  /// Hien nguoi nay o khu "Doi ngu" tren trang gioi thieu cong khai (anh yeu
  /// cau 25/09/2026). Mac dinh TAT: danh sach nhan vien la du lieu noi bo,
  /// dua ai len trang la quyet dinh cua quan ly.
  hienTrenTrang Boolean @default(false)
  /// So nho dung truoc trong khu do. Cung so thi xep theo ngay vao lam.
  thuTuHien     Int     @default(0)
  /// Mot dong nguoi do tu gioi thieu, hien duoi chuc vu o khu "Doi ngu".
  /// Nhan vien tu viet o "Tai khoan cua toi" (anh yeu cau 25/09/2026).
  gioiThieu     String?

  taoLuc     DateTime @default(now())
  capNhatLuc DateTime @updatedAt

  phien PhienDangNhap[]
  anh   AnhNhanVien?
}

/// Anh dai dien nhan vien tu tai len o trang "Tai khoan cua toi".
///
/// BANG RIENG chu khong phai mot cot trong NhanVien: moi truy van nhan vien
/// (danh sach, dang nhap, cham cong) se keo theo vai chuc KB anh moi dong neu
/// de chung — ma gan het cac cho do khong can anh.
///
/// Anh da nen san o trinh duyet truoc khi gui len (320x320, JPEG) nen chi con
/// vai chuc KB. Khong dung Google Drive: quyen hien tai chi doc, bat them
/// quyen ghi la phai xin lai ca tai khoan Google cua studio.
model AnhNhanVien {
  nhanVienId String   @id
  /// Du lieu anh. Kieu luon la image/jpeg (canvas o trinh duyet xuat ra vay).
  duLieu     Bytes
  capNhatLuc DateTime @updatedAt

  nhanVien NhanVien @relation(fields: [nhanVienId], references: [id], onDelete: Cascade)
}

/// Mot lan dang nhap dang con hieu luc cua mot nhan vien.
///
/// Luu trong database chu khong ky san vao cookie: nhan vien nghi viec hay bi
/// cap lai mat khau thi xoa dong o day la moi may cua ho bi dang xuat ngay,
/// khong phai doi cookie het han.
model PhienDangNhap {
  /// SHA-256 cua chuoi trong cookie — database khong giu chuoi that, lo database
  /// cung khong ai dung duoc phien.
  id         String   @id
  nhanVienId String
  taoLuc     DateTime @default(now())
  hetHan     DateTime

  nhanVien NhanVien @relation(fields: [nhanVienId], references: [id], onDelete: Cascade)

  @@index([nhanVienId])
}

/// Nhat ky thao tac trong phan quan ly studio: ai, luc nao, lam gi, sua tu gi
/// thanh gi. Lo sua sai (nhat la tien, luong) thi truy lai duoc.
///
/// nguoiId KHONG noi khoa toi NhanVien: nhat ky phai con nguyen ke ca khi sau
/// nay xoa nguoi do. Ten luu kem luc ghi (nguoiTen) vi cung ly do.
model NhatKy {
  id         String   @id @default(cuid())
  luc        DateTime @default(now())
  /// null = quan tri dang nhap bang mat khau quan ly chung.
  nguoiId    String?
  nguoiTen   String
  hanhDong   String
  doiTuong   String?
  doiTuongId String?
  chiTiet    Json?

  @@index([luc])
  @@index([doiTuong, doiTuongId])
}

/// Thong tin NOI BO cua studio — mot dong duy nhat (id = "studio"). Chi quan ly
/// xem va sua (ben AppSheet cu cung chi Admin xem duoc muc nay).
///
/// Thong tin LIEN HE CONG KHAI (ten, dia chi, hotline, Zalo, Facebook, ban do)
/// KHONG nam o day ma o src/lib/studio.ts — trang gioi thieu va khung Hoi Hamita
/// doc tu do. Giu hai noi cung mot so dien thoai la co ngay lech nhau. (Tiem
/// co HAI co so: 377 Do Tuong Tu la Wedding House, 337 la Hami Baby — anh xac
/// nhan 15/09/2026; ca hai nam trong studio.ts.)
model ThongTinStudio {
  id              String   @id @default("studio")
  nguoiDaiDien    String?
  soTaiKhoan1     String?
  soTaiKhoan2     String?
  /// "HH:MM" gio studio. Dung de tinh di tre khi cham cong (dot 4).
  gioBatDau       String?
  gioKetThuc      String?
  /// So gio nghi giua buoi, vd 1.5.
  gioNghiGiuaBuoi Float?
  /// So ngay cong chuan moi thang — mau so khi tinh luong theo ngay (dot 4).
  ngayCongThang   Int?
  /// "vi do, kinh do" cua studio — de kiem nhan vien cham cong dung cho (dot 4).
  toaDo           String?
  /// Toa do CO SO THU HAI — Hami Baby, 337 Do Tuong Tu (them 13/11/2026).
  ///
  /// Khong phai doan: gom cum 6.114 luot cham cong ben AppSheet ra mot cum
  /// 1.248 luot cach Wedding House 411m. Tiem that su co nguoi cham o ca hai
  /// noi, nen mot toa do la khong du de goi ten cho cham.
  toaDo2          String?
  capNhatLuc      DateTime @updatedAt
}

/// CHAM CONG — them 13/11/2026 (KE-HOACH-CRM.md dot 4).
///
/// Chep tu trang "Chấm công" ben AppSheet: 6.114 dong, 14/08/2023 → nay.
/// Day la bang NHIEU NGUOI DUNG NHAT: moi nhan vien bam hai lan moi ngay.
///
/// BON DIEU DO DUOC O DU LIEU THAT, quyet dinh cach dung bang nay:
///
///  1. `maNV` KHONG phai khoa ngoai sang NhanVien. Trong 6.114 dong co 46 ma
///     nhan vien, ma bang NhanVien chi con 27 — 28 ma da nghi viec, chiem
///     3.131 dong (51%). Dung khoa ngoai la mat nua lich su cham cong.
///     (Cau hoi nay treo tu 15/09/2026, nay do xong.)
///
///  2. KHONG CHAN THEO VI TRI. 39,6% luot cham cach tiem hon 500m, co cum xa
///     4–5 km — do la nhung buoi chup ngoai, phim truong. Chan theo toa do la
///     tu choi 4 trong 10 lan cham that. Toa do o day de GOI TEN cho cham
///     ("tai Wedding House", "ngoai tiem, cach 4,6 km"), khong de tu choi ai.
///
///  3. 334 luot co toa do "0,0" — may khong lay duoc vi tri. Bat buoc phai co
///     vi tri la nhung nguoi do khong cham cong duoc. Cho cham, ghi ro la
///     khong co vi tri, de quan ly tu nhin.
///
///  4. Anh chi co o 675/6.114 dong (11%), va duong dan tro vao thu muc
///     "Chấm công_Images" trong Drive cua NGUOI BAN — thu muc do chua bao gio
///     duoc chia se cho tiem. Nen anh cu KHONG chep sang duoc, chi giu lai
///     duong dan. Anh moi chup tren web nam o kho Drive 5 TB (`anhKho`).
model ChamCong {
  id             String    @id @default(cuid())
  /// Cot "ID Chấm công" ben AppSheet.
  maAppSheet     String?   @unique
  /// Ma nhan vien dang CHUOI, khong phai quan he — xem diem 1 o tren.
  maNV           String?
  /// Chep lai luc cham, vi nhan vien co the doi phong ban. Khong tra nguoc
  /// bang NhanVien: bang cong thang 3 phai ghi dung phong ban hoi thang 3.
  phongBan       String?
  /// "yyyy-mm-dd" theo gio studio (nguyen tac 35).
  ngay           String?
  gioVao         DateTime?
  gioRa          DateTime?
  /// So gio lam va so ngay cong. Dong chep tu AppSheet thi lay y nguyen so ben
  /// do de doi chieu o dot 7; dong cham tren web thi web tu tinh.
  soGio          Float?
  soNgayCong     Float?
  /// "Đi làm" | "Nghỉ làm"
  trangThai      String?
  /// "Đúng giờ" | "Trễ giờ". Ben AppSheet 2.114/5.993 luot la tre (35%).
  trangThaiVao   String?
  /// Nguyen van "vi do, kinh do" nhu ben AppSheet, vi du "10.437091, 106.476072".
  ///
  /// Giu mot chuoi chu khong tach hai cot so: chep sang phai giong het ben do
  /// de doi chieu o dot 7. Mot thang chi vai tram dong nen tinh khoang cach
  /// bang JavaScript luc doc la du, khong can tinh trong SQL.
  viTri          String?
  ghiChu         String?
  /// Duong dan anh ben AppSheet — thu muc khong duoc chia se, khong mo duoc.
  anhAppSheet    String?
  /// Ma tep anh tren kho Drive 5 TB, voi luot cham TREN WEB.
  anhKho         String?
  /// Cot "ID lương" ben AppSheet — dot 5 moi noi vao bang luong.
  luongAppSheet  String?
  taoLuc         DateTime  @default(now())
  bamAppSheet    String?
  matBenAppSheet DateTime?

  @@index([ngay])
  @@index([maNV, ngay])
}

/// DON TU — nghi phep, ung luong. Chep tu trang "Yêu cầu" (456 dong).
/// Them 13/11/2026 (KE-HOACH-CRM.md dot 5).
///
/// Do tren du lieu that: 449/456 la "Xin nghỉ", 5 "Xin ứng lương", 2 "Nghỉ
/// buổi chiều". Loai nghi: 332 huong luong, 119 khong huong luong. Trang thai:
/// 445 da duyet, 6 dang tao, 5 khong duyet.
///
/// Cot "Tin nhắn" ben AppSheet chi co 1/456 dong — bo han, khong chep.
model DonTu {
  id             String    @id @default(cuid())
  maAppSheet     String?   @unique
  /// Nguoi gui don. Chuoi chu khong khoa ngoai, cung ly do voi ChamCong.
  maNV           String?
  /// "Xin nghỉ" | "Xin ứng lương" | "Nghỉ buổi chiều"
  loaiDon        String?
  /// "Hưởng lương" | "Không hưởng lương". Chi co nghia voi don xin nghi.
  loaiNghi       String?
  ngayYeuCau     String?
  lyDo           String?
  /// Chi don xin ung luong moi co (5/456 dong ben AppSheet).
  soTien         Int?
  /// "Đang tạo" | "Đã duyệt" | "Không duyệt"
  trangThai      String?
  nguoiDuyetMaNV String?
  ngayDuyet      String?
  ghiChu         String?
  anhAppSheet    String?
  anhKho         String?
  taoLuc         DateTime  @default(now())
  bamAppSheet    String?
  matBenAppSheet DateTime?

  @@index([maNV, ngayYeuCau])
  @@index([trangThai])
}

/// DANH GIA — thuong/phat tung nguoi. Chep tu trang "Đánh giá" (444 dong).
///
/// Do duoc: 420 thuong, 24 phat. Cot "Diễn giải" trong 412/444 dong; phan co
/// chu phan lon tro toi ma noi quy ("P012 - Ko checkin-[Nội quy]").
///
/// NOI VAO BANG LUONG bang cap (ma nhan vien + ky luong), KHONG bang id:
/// AppSheet co mot cot id dang bam ("f51c54c1") ma ban xuat Excel khong he co.
/// Doi chieu 231/231 dong bang cap (maNV, ky) thi khop ca Thuong lan Phat.
model DanhGia {
  id             String    @id @default(cuid())
  maAppSheet     String?   @unique
  maNV           String?
  ngay           String?
  /// "Thưởng" | "Phạt"
  loai           String?
  dienGiai       String?
  /// Muc tien mot lan va so lan — ben AppSheet soTien = mucTien × soLan.
  mucTien        Int?
  soLan          Float?
  soTien         Int       @default(0)
  ghiChu         String?
  /// Ky luong "MM/YYYY", nguyen van nhu cot "Lương_id" ben AppSheet.
  kyLuong        String?
  taoLuc         DateTime  @default(now())
  bamAppSheet    String?
  matBenAppSheet DateTime?

  @@index([maNV, kyLuong])
  @@index([ngay])
}

/// KY LUONG — mot thang luong cua ca tiem. Chep tu trang "Lương" (30 dong).
model KyLuong {
  id             String    @id @default(cuid())
  /// Cot "ID" ben AppSheet, dang "06/2024".
  maAppSheet     String?   @unique
  nam            Int?
  thang          Int?
  soNV           Int?
  luongCung      Int       @default(0)
  luongSP        Int       @default(0)
  thuong         Int       @default(0)
  phat           Int       @default(0)
  tamUng         Int       @default(0)
  tongLuong      Int       @default(0)
  nguoiLapMaNV   String?
  ngayLap        String?
  /// Chot roi thi khong tinh lai nua — xem `chotKyLuong` trong src/lib/luong.ts.
  daChot         Boolean   @default(false)
  taoLuc         DateTime  @default(now())
  bamAppSheet    String?
  matBenAppSheet DateTime?

  @@index([nam, thang])
}

/// LUONG MOT NGUOI MOT THANG. Chep tu trang "Lương nhân viên" (341 dong).
///
/// CONG THUC — do nguoc tu 341 dong that, khong doan:
///   Lương tháng = Lương cứng ÷ ngày công tháng × Số ngày làm việc  (lech <= 10d)
///   Tổng lương  = Lương tháng + Lương SP + Thưởng − Phạt           341/341
///   Thực lãnh   = Tổng lương − Tạm ứng                             341/341
///   Còn lại     = Thực lãnh − Đã thanh toán                        341/341
///
/// NGUON TUNG SO — cung do nguoc:
///   Số ngày làm việc ← tong soNgayCong bang ChamCong theo (maNV, thang)  227/227
///   Lương SP         ← tong thanhTien bang CongViec theo ngayHoanThanh   260/261
///   Thưởng / Phạt    ← tong bang DanhGia theo (maNV, ky)                 231/231
model LuongNhanVien {
  id             String    @id @default(cuid())
  /// Cot "lable" ben AppSheet, dang "06-2024-Phạm Thị Tiểu Mi" — 341/341 duy nhat.
  maAppSheet     String?   @unique
  /// Ky luong "MM/YYYY", cot "Lương ID" ben AppSheet.
  kyLuong        String?
  nam            Int?
  thang          Int?
  maNV           String?
  /// Chep lai luc chot luong, khong tra nguoc bang NhanVien.
  phongBan       String?
  luongCung      Int       @default(0)
  soNgayLam      Float     @default(0)
  soGioLam       Float     @default(0)
  luongThang     Int       @default(0)
  luongSP        Int       @default(0)
  thuong         Int       @default(0)
  phat           Int       @default(0)
  tongLuong      Int       @default(0)
  tamUng         Int       @default(0)
  thucLanh       Int       @default(0)
  daThanhToan    Int       @default(0)
  conLai         Int       @default(0)
  ghiChu         String?
  taoLuc         DateTime  @default(now())
  bamAppSheet    String?
  matBenAppSheet DateTime?

  @@index([kyLuong])
  @@index([maNV, kyLuong])
}

/// Noi quy studio va muc phat moi lan vi pham. Moi nguoi xem duoc, chi quan ly
/// sua.
///
/// KHONG XOA — chi ngung ap dung (dangApDung = false): nhung lan phat da ghi
/// (dot 4) van tro toi noi quy do, xoa di thi lich su phat mat ly do.
model NoiQuy {
  id         String   @id @default(cuid())
  /// Ma ben AppSheet cu (P01, P02…) — de ghep lich su thuong phat khi chuyen o dot 4.
  maNQ       String?  @unique
  noiDung    String
  /// Muc phat moi lan, tinh bang dong.
  mucPhat    Int      @default(0)
  thuTu      Int      @default(0)
  dangApDung Boolean  @default(true)
  taoLuc     DateTime @default(now())
  capNhatLuc DateTime @updatedAt
}

/// Bang dich vu, trang phuc, san pham — trang "Dịch vụ" ben AppSheet cu (nhap
/// 15/09/2026: 887 trang phuc, 95 dich vu, 36 san pham).
///
/// Ai dang nhap cung XEM duoc (sale bao gia, phong Vay tra mau). SUA: quan ly,
/// sale, va phong Vay (chi trang phuc) — xem loaiDuocSua() trong
/// src/lib/dichVuChung.ts.
///
/// KHONG XOA — chi ngung dung (dangDung = false): hop dong (dot 2) se tro toi
/// dich vu, xoa di thi hop dong cu mat ten mat gia.
model DichVu {
  id           String   @id @default(cuid())
  /// Ma ben AppSheet ("QPS7TR", "ADQ01"…), giu nguyen chu nhu da go. KHONG DOI
  /// DUOC sau khi tao: hop dong cu ben AppSheet tim dich vu bang ma nay (dot 2).
  maDV         String   @unique
  /// "dich-vu" | "trang-phuc" | "san-pham" — xem LOAI_DICH_VU.
  loai         String
  ten          String
  /// Nhom trong loai — cot "Loại DV" ben AppSheet (Cưới, Baby, Thuê lẻ, IN ẢNH…). Chu tu do.
  nhom         String?
  chiTiet      String?
  /// Ma album gan san cho dich vu nay — "HC", "AB", "Baby", "NS"… (xem
  /// MA_ALBUM trong src/lib/maAlbum.ts). null = khong gan ma nao.
  ///
  /// Them 18/11/2026: luc tao album tu hop dong, web lay ma tu day cong voi
  /// ma suy ra tu loai buoi trong lich (nha gai -> HER, nha trai -> HIS).
  /// Truoc do chi co nguon thu hai, nen hop dong Baby hay Nha Su ra album
  /// ten tron, khong loc duoc o trang quan ly album.
  maAlbum      String?
  donGia       Int      @default(0)
  donVi        String?
  /// Duong dan anh ben AppSheet ("Dịch vụ_Images/ADQ01.Hình ảnh.083439.jpg").
  /// Thu muc anh cua app chua duoc nguoi ban chia se (do 15/09) — giu duong dan
  /// de ghep anh khi co quyen.
  hinhAppSheet String?
  dangDung     Boolean  @default(true)
  taoLuc       DateTime @default(now())
  capNhatLuc   DateTime @updatedAt

  chiPhi      GiaHangMuc[]
  dongHopDong ChiTietHopDong[]
  /// Buoi chup mac dinh — xem model DichVuBuoi.
  buoi        DichVuBuoi[]

  @@index([loai, dangDung])
}

/// Chi phi tung hang muc cua mot dich vu — trang "Dịch vụ CT" ben AppSheet
/// (315 dong cho 98 dich vu): tien tra tho chup, makeup, photoshop, xuong in,
/// hoa… moi lan lam dich vu do. La nen de tinh luong san pham o dot 4.
///
/// CHI QUAN LY xem: phan lon la tien cong tho (studio chot 15/09: chi quan ly
/// xem luong moi nguoi).
model GiaHangMuc {
  id         String   @id @default(cuid())
  dichVuId   String
  /// "PHOTO", "Makeup", "Xưởng in"… giu nguyen chu ben AppSheet.
  hangMuc    String?
  donGia     Int      @default(0)
  /// Cot "ID" ben AppSheet — chay lai script nhap khong bi trung.
  maAppSheet String?  @unique
  taoLuc     DateTime @default(now())

  dichVu DichVu @relation(fields: [dichVuId], references: [id], onDelete: Restrict)

  @@index([dichVuId])
}

/// ── Dot 2: hop dong & khach (15/09/2026) ────────────────────────────────────
///
/// GIAI DOAN SONG SONG (studio chot 15/09): nhan vien VAN lam hop dong, phieu
/// thu ben AppSheet; web TU CHEP sang moi dem (src/lib/dongBoAppSheet.ts) de
/// xem, tim, xem cong no. Web CHUA sua bon bang duoi — sua o day thi dem sau
/// bi ghi de. Xong dot 3 (lich, cong viec) anh chon ngay chuyen han.
///
/// Dong chep tu AppSheet mang khoa ben kia (maAppSheet / maHD) va `bamAppSheet`
/// — dau van tay luc chep gan nhat, khong doi thi khong ghi lai. Dong bien mat
/// ben AppSheet KHONG bi xoa o web, chi danh dau `matBenAppSheet`.

/// Khach hang — trang "Khách hàng" ben AppSheet (1.978 khach).
model KhachHang {
  id             String    @id @default(cuid())
  /// "Mã KH" ben AppSheet — gan nhu luon la so dien thoai (1.938/1.978, do 15/09).
  maAppSheet     String?   @unique
  ten            String
  soDienThoai    String?
  tinh           String?
  ghiChu         String?
  /// Ma nhan vien tao ben AppSheet (NhanVien.maNV).
  nguoiTaoMaNV   String?
  taoLuc         DateTime  @default(now())
  bamAppSheet    String?
  matBenAppSheet DateTime?

  hopDong HopDong[]

  @@index([soDienThoai])
}

/// Hop dong — trang "Hợp đồng" ben AppSheet (2.225 hop dong).
///
/// Tien la dung con so AppSheet tinh (do 15/09: Tong = Thanh tien − KM va Con
/// lai = Tong − Da thu dung ca 2.225 dong), chua tinh lai o web.
model HopDong {
  id             String    @id @default(cuid())
  /// "Mã HĐ" ben AppSheet (dang STT_…).
  maHD           String    @unique
  khachHangId    String?
  /// Ten ghi tren hop dong — co khi khac ten trong bang khach.
  tenKhach       String
  /// Khách lẻ, CƯỚI, HỎI, Baby, NHÀ SU, kỉ yếu, PreWedding… — giu chu ben AppSheet.
  loaiDV         String?
  danhSachDV     String?
  /// "YYYY-MM-DD" — ngay khong gio, luu dang chu cho khoi lech mui gio.
  ngayDat        String?
  thanhTien      Int       @default(0)
  khuyenMai      Int       @default(0)
  tongTien       Int       @default(0)
  /// "Thanh toán" ben AppSheet = cong MOI phieu thu, ke ca phieu cho duyet.
  daThu          Int       @default(0)
  conLai         Int       @default(0)
  /// Nguyen chu ben AppSheet, vd "12. Đã xong tiệc".
  trangThai      String?
  /// So buoc tach tu trangThai: 1–9 nhanh chup studio, 10–18 nhanh tiec.
  buoc           Int?
  ngayHoanThanh  String?
  diaChi         String?
  ghiChu         String?
  nguoiLapMaNV   String?
  taoLuc         DateTime  @default(now())
  bamAppSheet    String?
  matBenAppSheet DateTime?

  khachHang KhachHang?       @relation(fields: [khachHangId], references: [id], onDelete: SetNull)
  chiTiet   ChiTietHopDong[]
  phieuThu  PhieuThu[]
  album     Gallery[]
  lich      LichChup[]
  congViec  CongViec[]

  @@index([khachHangId])
  @@index([ngayDat])
  @@index([buoc])
}

/// Tung dong dich vu, trang phuc, san pham trong hop dong — "Hợp đồng CT".
model ChiTietHopDong {
  id             String    @id @default(cuid())
  /// "Mã chi tiết HĐ" ben AppSheet.
  maAppSheet     String    @unique
  hopDongId      String
  /// "dich-vu" | "trang-phuc" | "san-pham" (LOAI_DICH_VU).
  loai           String?
  ngayChup       String?
  /// Ma dich vu ghi tren dong. 1.081/6.675 dong mang ma KHONG con trong bang
  /// Dich vu (do 15/09: vest cu VET…, ao dai cu…) — nen giu ca ma lan ten
  /// ngay tren dong; dichVuId chi co khi ghep duoc.
  maDV           String?
  dichVuId       String?
  tenDV          String?
  chiTiet        String?
  donGia         Int       @default(0)
  soLuong        Float     @default(0)
  thanhTien      Int       @default(0)
  ghiChu         String?
  nguoiLapMaNV   String?
  taoLuc         DateTime  @default(now())
  bamAppSheet    String?
  matBenAppSheet DateTime?

  hopDong  HopDong    @relation(fields: [hopDongId], references: [id], onDelete: Cascade)
  dichVu   DichVu?    @relation(fields: [dichVuId], references: [id], onDelete: SetNull)
  congViec CongViec[]

  @@index([hopDongId])
  @@index([ngayChup])
}

/// Phieu thu — trang "Thu" ben AppSheet (3.950 phieu).
model PhieuThu {
  id             String    @id @default(cuid())
  /// Cot "Id" ben AppSheet.
  maAppSheet     String?   @unique
  hopDongId      String?
  /// "Tiền mặt" | "Chuyển khoản"
  hinhThuc       String?
  /// Tai khoan ngan hang cua tiem nhan tien chuyen khoan.
  taiKhoan       String?
  /// Cot "Loại thanh toán" ben AppSheet — chu tu do: Cọc, Cọc lần 1, Đủ…
  noiDung        String?
  ngayThu        String?
  soTien         Int       @default(0)
  /// "Đã thu tiền mặt" | "Đã thu chuyển khoản" | "Chờ duyệt"
  trangThai      String?
  ghiChu         String?
  nguoiTaoMaNV   String?
  nguoiDuyetMaNV String?
  /// Duong dan anh chung tu ben AppSheet — thu muc anh chua duoc chia se.
  anhAppSheet    String?
  taoLuc         DateTime  @default(now())
  bamAppSheet    String?
  matBenAppSheet DateTime?

  hopDong HopDong? @relation(fields: [hopDongId], references: [id], onDelete: SetNull)

  @@index([hopDongId])
  @@index([ngayThu])
}

/// So CHI — doi trong cua PhieuThu. Them 13/11/2026 (KE-HOACH-CRM.md dot 3).
///
/// Truoc do web co Thu ma khong co Chi nen khong ra duoc so du. Chep tu trang
/// "Chi" ben AppSheet: 1.397 dong, tu 30/08/2023 toi 12/11/2026.
///
/// BA DIEU DO DUOC O DU LIEU THAT, quyet dinh cach dung bang nay:
///
///  1. Cot "Hợp đồng" ben AppSheet co 0/1397 dong co gia tri — so chi CHUA BAO
///     GIO noi voi hop dong. Nen o day KHONG co `hopDongId`. Can noi thi them
///     sau, dung dung quan he ma khong ai dung.
///  2. Cot "Loại chi" ben AppSheet that ra la HINH THUC TRA (Tiền mặt /
///     Chuyển Khoản), con "Tên Loại chi" moi la KHOAN CHI. Ten cot ben do dat
///     nguoc, nen o day doi lai cho dung nghia: `hinhThuc` va `khoanChi`.
///  3. Trang thai ben AppSheet chi co HAI gia tri — "Đã chi tiền mặt" va
///     "Đã chi chuyển khoản". KHONG co "Chờ duyệt" nhu ben Thu. Phieu lap tren
///     web thi co, vi tren web ai cung lap duoc con duyet la viec cua quan ly.
///
/// Khong chuan hoa chu hoa chu thuong khi chep ("Tech" / "tech" / "Hami Tech"
/// la ba gia tri khac nhau ben do): chuan hoa la luc doi chieu hai ben o dot 7
/// khong khop nua. Don dep la viec rieng, lam sau khi chuyen xong.
model ChiTieu {
  id             String    @id @default(cuid())
  /// Cot "u" ben AppSheet — ten cot ben do dung la mot chu "u".
  maAppSheet     String?   @unique
  /// "Tiền mặt" | "Chuyển Khoản" — xem diem 2 o chu thich tren.
  hinhThuc       String?
  /// Tai khoan ngan hang chi ra. Trong voi chi tien mat (898/1397 dong trong).
  taiKhoan       String?
  /// Khoan chi: "Trả lương", "Lấy váy", "TRANG PHỤC"… 139 gia tri, chu tu do.
  khoanChi       String?
  /// Cot "Thông tin" — dien giai chi tiet (890/1397 dong co).
  dienGiai       String?
  ngayChi        String?
  soTien         Int       @default(0)
  /// "Đã chi tiền mặt" | "Đã chi chuyển khoản" | "Chờ duyệt" (chi tren web).
  trangThai      String?
  ghiChu         String?
  nguoiNhan      String?
  nguoiTaoMaNV   String?
  nguoiDuyetMaNV String?
  /// Ma dong bang "Lương nhân viên" ben AppSheet (254/1397 dong co). Giu lai de
  /// dot 5 noi duoc so chi voi bang luong, chua dung toi o dot 3.
  luongAppSheet  String?
  /// Duong dan anh chung tu ben AppSheet — thu muc anh chua duoc chia se nen
  /// chi giu chuoi, khong mo duoc. Xem chu thich tuong tu o PhieuThu.
  anhAppSheet    String?
  /// Ma tep anh chung tu tren kho Drive, voi phieu LAP TREN WEB. Xem
  /// src/lib/khoAnh.ts — anh nam o o 5 TB cua hamitaweddinghouse@gmail.com.
  anhKho         String?
  taoLuc         DateTime  @default(now())
  bamAppSheet    String?
  matBenAppSheet DateTime?

  @@index([ngayChi])
  @@index([trangThai])
}

/// Lich chup — trang "Lịch" ben AppSheet (1.312 dong, 15 loai: ngay chup, nha
/// gai, nha trai, dinh hon, Hami Baby, chup be…).
///
/// Cung luat voi cac bang dot 2: chep tu AppSheet moi gio, web CHI XEM
/// (src/lib/dongBoAppSheet.ts).
model LichChup {
  id             String    @id @default(cuid())
  /// Cot "Id" ben AppSheet.
  maAppSheet     String?   @unique
  hopDongId      String?
  /// "YYYY-MM-DD" — ngay khong gio, luu dang chu cho khoi lech mui gio.
  ngay           String?
  /// "HH:MM" gio Viet Nam, hoac null. Them 13/11/2026 (KE-HOACH-UX.md P1-4).
  ///
  /// AppSheet KHONG co cho nao luu gio chup: do 1.454 buoi, chi 26 buoi (1,8%)
  /// co thu trong nhu gio, va deu nam lan trong ghi chu. Nen cot nay bat dau
  /// tu con so khong — no chi co ich neu sale chiu dien tu nay tro di.
  ///
  /// Luu dang CHU chu khong phai DateTime, cung ly do voi `ngay`: mot gio hen
  /// "07:30" la 07:30 gio Viet Nam, khong phai mot thoi diem UTC phai doi.
  gio            String?
  loai           String?
  /// Vi sao buoi nay CHUA CO NGAY — chi co nghia khi `ngay` la null.
  ///
  /// Anh chot 19/11/2026. Truoc do web loai han dong lich bo trong ngay, nen
  /// mot hop dong "chua co ngay chup" khong co dong lich nao: mat luon thong
  /// tin khach da mua buoi gi, va ma album khong suy ra duoc (ma suy tu LOAI
  /// BUOI, ma loai buoi nam o chinh dong lich do).
  ///
  /// Hai gia tri khac nhau ve VIEC PHAI LAM: "khach chua chot ngay" thi chi
  /// goi nhac, con "da hoan" thi phai bao ekip da xep nguoi. Do 1.456 buoi cu:
  /// 0 buoi nao ghi ly do hoan o bat cu dau.
  ///
  /// Gia tri lay tu nhom "ly-do-trong-ngay" cua bang DanhMuc (co CRUD).
  lyDoTrong      String?
  ghiChu         String?
  /// "Hoàn thành" | "Đang làm" | "Chưa làm"
  trangThai      String?
  /// Cot "Hiển thị": mot dong chu gon AppSheet dung de ve len lich.
  hienThi        String?
  nguoiTaoMaNV   String?
  taoLuc         DateTime  @default(now())
  bamAppSheet    String?
  matBenAppSheet DateTime?

  hopDong HopDong? @relation(fields: [hopDongId], references: [id], onDelete: SetNull)

  @@index([ngay])
  @@index([hopDongId])
}

/// Dau viec — trang "Tiến độ công việc" ben AppSheet (4.577 dong): moi dong
/// dich vu trong hop dong duoc giao cho mot nguoi, co thoi han va trang thai.
model CongViec {
  id                String    @id @default(cuid())
  /// Cot "ID" ben AppSheet.
  maAppSheet        String?   @unique
  hopDongId         String?
  /// Dong chi tiet hop dong sinh ra dau viec nay (cot "Hợp đồng CT").
  chiTietId         String?
  /// Viec gi: "Chụp ảnh", "Photoshop", "Makeup", "Dựng phim"… (67 kieu ben AppSheet).
  loai              String?
  soLuong           Float     @default(0)
  donGia            Int       @default(0)
  thanhTien         Int       @default(0)
  /// Ma nhan vien duoc giao (NhanVien.maNV).
  nguoiPhuTrachMaNV String?
  thoiHan           String?
  ngayXuLy          String?
  ngayHoanThanh     String?
  /// "Đã làm" | "Đang làm" | "Chưa giao việc"
  trangThai         String?
  /// Chu AppSheet tu tinh khi xong: "Trễ hẹn", "Đúng hẹn", "Sớm hẹn"…
  tienDo            String?
  ghiChu            String?
  taoLuc            DateTime  @default(now())
  bamAppSheet       String?
  matBenAppSheet    DateTime?

  hopDong HopDong?        @relation(fields: [hopDongId], references: [id], onDelete: SetNull)
  chiTiet ChiTietHopDong? @relation(fields: [chiTietId], references: [id], onDelete: SetNull)

  @@index([hopDongId])
  @@index([nguoiPhuTrachMaNV])
  @@index([thoiHan])
  @@index([trangThai])
}

/// Thu muc con cua mot album duoc dua len trang gioi thieu /dich-vu/<nhom>/<muc>
/// (xem src/lib/nhomGioiThieu.ts).
///
/// Chon tai trang quan ly "Trang gioi thieu" (/admin/gioi-thieu), anh yeu cau
/// 17/09/2026. Tra theo MA thu muc (nguyen tac 32), giu kem ten va tam dau tien
/// luc chon de trang quan ly hien duoc ma khong goi Drive (nguyen tac 9).
/// Muc nho cua mot nhom dich vu tren trang gioi thieu (Dam ngo, Dinh hon...).
///
/// Truoc 25/09/2026 danh sach nay viet cung trong src/lib/nhomGioiThieu.ts, nen
/// them mot muc phai sua ma nguon. Anh yeu cau tu tao duoc tren web nen chuyen
/// vao day. Lan dau chay ma bang trong thi tu nap danh sach cu (MUC_MAC_DINH).
model MucDichVu {
  id     String   @id @default(cuid())
  /// Key nhom (src/lib/nhomGioiThieu.ts) — nhom van co dinh, chi muc la mem.
  nhom   String
  /// Doan duong dan gui khach: /dich-vu/anh-cuoi/dam-ngo. KHONG doi sau khi tao
  /// (link da gui khach se hong) va KHONG trung giua cac nhom, vi khoa khong
  /// trung cua AnhGioiThieu chi theo (muc, galleryId, albumId).
  key    String   @unique
  ten    String
  /// Ma dau ten album dung de GOI Y album khi them. Rong = hien moi album.
  ma     String[] @default([])
  /// So nho dung truoc. Cung so thi xep theo `taoLuc`.
  thuTu  Int      @default(0)
  taoLuc DateTime @default(now())

  @@index([nhom, thuTu])
}

model AnhGioiThieu {
  id        String   @id @default(cuid())
  /// Nhom dich vu (src/lib/nhomGioiThieu.ts). Dong tao truoc 17/09 toi deu la anh cuoi.
  /// Key muc KHONG trung giua cac nhom nen unique van theo (muc, galleryId, albumId).
  nhom      String   @default("anh-cuoi")
  muc       String
  galleryId String
  /// Ma thu muc con. Chuoi rong = anh nam ngay thu muc goc.
  albumId   String
  /// Ten thu muc DOC TU DRIVE luc them. Giu nguyen de con doi chieu khi doc lai.
  tenMuc    String
  /// Ten studio dat de hien cho khach — null thi dung `tenMuc`.
  ///
  /// Anh yeu cau 23/09/2026 cho Hamita Garden: moi thu muc tren Drive la mot
  /// canh chup, ma ten thu muc hay la "All View HamitaGarden", "canh 1"… Khach
  /// khong nen doc thay may ten do.
  tenHien   String?
  /// Mot dong gioi thieu canh, hien duoi ten trong luoi (cung yeu cau 23/09).
  moTa      String?
  /// So nho dung truoc. Cung so thi xep theo `taoLuc` nhu cu.
  thuTu     Int      @default(0)
  anhBia    String?
  soAnh     Int      @default(0)
  taoLuc    DateTime @default(now())

  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@unique([muc, galleryId, albumId])
  @@index([muc])
}

/// KHACH TIEM NANG — bang "CRM" ben AppSheet (35 dong, do 13/11/2026).
///
/// Nguoi moi hoi gia, chua thanh hop dong. Khac KhachHang o cho do: KhachHang
/// la nha DA co ma khach (= so dien thoai) va thuong da co hop dong; day la
/// danh sach sale con dang theo duoi, 7/35 dong chua co ca so dien thoai.
///
/// Khoa `maAppSheet` lay cot "CRM" — mot timestamp, 35/35 rieng.
model KhachTiemNang {
  id             String    @id @default(cuid())
  maAppSheet     String?   @unique
  /// Ngay ghi nhan moi quan tam (cot "Ngày").
  ngay           String?
  tenNguoi       String
  soDienThoai    String?
  /// "Facebook" | "Giới thiệu" | "Zalo" | "Page Hamita" — xem NGUON_KHACH.
  nguon          String?
  /// Khach muon chup gi: "Chụp hình cưới", "ảnh cổng"…
  nhuCau         String?
  diaChi         String?
  /// Ma nhan vien dang theo khach nay (NhanVien.maNV). Chuoi chu, khong khoa
  /// ngoai — cung ly do voi ChamCong: 2/7 ma ben AppSheet khong co trong bang
  /// Nhan vien, khoa ngoai la mat luon dong do.
  phuTrachMaNV   String?
  /// Kha nang chot: "Tiềm năng" | "Dò giá" | "Tư vấn lần 1"… — xem KHA_NANG.
  ///
  /// BAT BUOC co (35/35 dong ben AppSheet deu co). De nullable la bo loc
  /// "dang theo" dung `not: "Đã chốt"` se danh roi dong NULL — trong Postgres
  /// `NULL != 'x'` khong phai dung, nen khach thieu muc nay bien mat khoi CA
  /// HAI bo loc ma khong ai nhin ra.
  khaNang        String    @default("Tiềm năng")
  /// Viec dang lam voi khach: "Tư vấn" | "Báo giá" | "Chốt deal"… — xem TINH_TRANG.
  tinhTrang      String?
  ghiChu         String?
  /// "Zalo" | "Phone" — nhan vien lien lac bang duong nao.
  loaiCskh       String?
  /// Nhat ky goi dien / nhan tin, moi lan them mot dong.
  lichSuCskh     String?
  /// Ngay hen goi lai. Thu dang gia nhat cua ca bang nay.
  ngayLienHeLai  String?
  nguoiTaoMaNV   String?
  taoLuc         DateTime  @default(now())
  suaLuc         DateTime  @updatedAt
  bamAppSheet    String?
  matBenAppSheet DateTime?

  @@index([ngayLienHeLai])
  @@index([khaNang])
}

/// MUOI TAM BUOC CUA HOP DONG — bang "Trạng thái" ben AppSheet (18 dong).
///
/// Truoc 13/11/2026 danh sach nay nam CUNG trong `src/lib/hopDongChung.ts`
/// (CAC_BUOC). Doi ten mot buoc la phai sua code va deploy lai, trong khi
/// studio co the muon doi chu. Dua vao database de sua duoc tren web.
///
/// CODE VAN GIU CAC_BUOC lam ban du phong: bang nay rong (chua chep) thi form
/// hop dong khong duoc phep tro nen trong tron.
/// BUOI CHUP MAC DINH CUA MOT DICH VU — anh yeu cau 18/11/2026.
///
/// "Moi dich vu deu di kem loai buoi chup, de khi lap hop dong chon dich vu
/// la co san lich chup va loai buoi luon, nguoi lap chi chon ngay gio thoi."
///
/// Truoc do web DOAN: so buoi doc tu ten goi ("2 ngay"), loai buoi do bang
/// regex trong phan chi tiet ("Nhà gái : chụp phóng sự"). Doan dung 7/95 goi
/// — dung voi GTC2DAY nhung chiu thua voi moi goi khac.
///
/// Luu `loaiBuoiId` chu KHONG luu ten: tu 18/11 ten loai buoi sua duoc o trang
/// Quan ly dich vu, luu ten thi doi ten la phai nho cap nhat them cho nay.
///
/// KHONG unique (dichVuId, loaiBuoiId): mot goi co the can HAI buoi cung loai,
/// vi du hai ngay deu la "Ngày chụp". Thu tu quyet dinh dong nao truoc.
model DichVuBuoi {
  id         String   @id @default(cuid())
  dichVuId   String
  loaiBuoiId String
  thuTu      Int      @default(0)
  taoLuc     DateTime @default(now())

  dichVu   DichVu   @relation(fields: [dichVuId], references: [id], onDelete: Cascade)
  loaiBuoi LoaiBuoi @relation(fields: [loaiBuoiId], references: [id], onDelete: Cascade)

  @@index([dichVuId, thuTu])
  @@index([loaiBuoiId])
}

/// MA ALBUM (TAG) — anh yeu cau 19/11/2026, thay bang cung MA_ALBUM.
///
/// Ma dung o dau ten album: "HIS - Minh Ngoc & Cong Khoa". Do 19/11 tren 181
/// album: HIS 47, HER 45, HC 39, Baby 30, AB 25, NS 20, GD 10, DH 6, Bau 1,
/// DN 1, NP 0, TET 0.
///
/// KHONG CHO DOI `ma` khi da co album dung — anh chot 19/11. Ma nam TRONG ten
/// album, ma ten album la chu tu do: cung mot ma co cai viet "HIS - ", cai
/// viet "His-", cai viet "HIS-". Sua hang loat la de sot hoac sua nham. Them
/// ma moi va tat ma cu thi van duoc.
///
/// `nghia` sua duoc luc nao cung duoc: no chi hien trong goi y, khong nam
/// trong du lieu nao.
model MaAlbum {
  id         String   @id @default(cuid())
  /// Chu hien o dau ten album. Khong doi duoc khi da co album dung.
  ma         String   @unique
  /// "hinh cong", "nha trai"… — hien khi re chuot len nut chon ma.
  nghia      String?
  thuTu      Int      @default(0)
  /// false = khong hien trong o chon nua; album cu van loc duoc binh thuong.
  dangDung   Boolean  @default(true)
  taoLuc     DateTime @default(now())
  capNhatLuc DateTime @updatedAt

  @@index([dangDung, thuTu])
}

/// DANH MUC DUNG CHUNG — anh yeu cau 18/11/2026.
///
/// Mot bang cho MOI danh muc nho cua form lap hop dong, phan biet bang cot
/// `nhom`. Lam vay thay vi moi danh muc mot bang vi chung giong het nhau:
/// chi co ten, thu tu, bat/tat. Ba bang rieng la ba lan sua schema, ba server
/// action gan nhu chep lai nhau.
///
///   "loai-hop-dong"  CUOI, HOI, Baby, NHA SU…   (13 gia tri, 2.399 hop dong)
///   "hinh-thuc-thu"  Tien mat, Chuyen khoan      (2 gia tri, 4.282 phieu)
///   "noi-dung-thu"   Coc, Coc lan 1, Du…         (5 GOI Y — xem duoi)
///
/// RIENG "noi-dung-thu" chi la GOI Y, khong phai danh sach dong: do 18/11 co
/// 234 noi dung go tay ngoai bang (605 phieu) — "Cọc 200k", "Tt giày",
/// "thanh toán 3 bộ vest". Khoa lai la 605 phieu kieu do khong lap lai duoc.
///
/// Loai buoi chup (LoaiBuoi) va buoc hop dong (BuocHopDong) KHONG nam o day:
/// chung co cot rieng — maAlbum, truoc/sau/trachNhiem.
model DanhMuc {
  id         String   @id @default(cuid())
  /// "loai-hop-dong" | "hinh-thuc-thu" | "noi-dung-thu".
  nhom       String
  /// Gia tri hien trong o chon, va luu thang vao cot cua hop dong / phieu thu.
  ten        String
  thuTu      Int      @default(0)
  /// false = khong hien trong o chon nua, du lieu cu van doc binh thuong.
  dangDung   Boolean  @default(true)
  taoLuc     DateTime @default(now())
  capNhatLuc DateTime @updatedAt

  @@unique([nhom, ten])
  @@index([nhom, dangDung, thuTu])
}

/// LOAI BUOI CHUP — anh yeu cau 18/11/2026, thay bang cung LOAI_LICH.
///
/// Truoc do 12 loai nam cung trong src/lib/hopDongChung.ts. Do 18/11: ba loai
/// CO THAT trong du lieu ma khong co trong bang cung — "Chụp sự kiện" (4 buoi),
/// "Chụp chịu lạy" (3), "chụp đầy tháng" (1). Lich cu mang chung nhung khong
/// lap moi duoc, y het chuyen "DẠM NGÕ" thieu trong LOAI_DV_HD hoi 14/11.
///
/// `LichChup.loai` luu CHU chu khong luu id. Nen doi `ten` o day phai cap nhat
/// luon moi dong lich mang ten cu (anh chot 18/11) — xem suaLoaiBuoiAction.
///
/// Bang rong thi web dung lai bang cung, y nhu BuocHopDong.
model LoaiBuoi {
  id         String   @id @default(cuid())
  /// Ten hien trong o chon va luu vao LichChup.loai.
  ten        String   @unique
  /// Ma album suy ra tu loai nay — "nhà gái" ra HER, "Đính Hôn" ra ĐH.
  /// null = loai nay khong suy ra ma nao (vd "Ngày chụp" chung chung).
  maAlbum    String?
  /// Nho dung truoc trong o chon. Cung so thi xep theo ten.
  thuTu      Int      @default(0)
  /// false = khong hien trong o chon nua, nhung lich cu van doc binh thuong.
  /// Dung thay cho xoa khi loai da co lich (anh chot 18/11).
  dangDung   Boolean  @default(true)
  taoLuc     DateTime @default(now())
  capNhatLuc DateTime @updatedAt

  /// Dich vu nao dang lay loai buoi nay lam mac dinh.
  dichVu DichVuBuoi[]

  @@index([dangDung, thuTu])
}

model BuocHopDong {
  id         String   @id @default(cuid())
  /// Ten buoc, dung nguyen chu ben AppSheet — 2.541 hop dong dang mang chuoi nay.
  ten        String   @unique
  /// So thu tu doc tu dau ten ("5. Đang Retouch" → 5). Khong doc duoc thi 999.
  thuTu      Int      @default(999)
  /// Buoc lien truoc, theo cot "Trạng thái trước". 11/18 dong co.
  truoc      String?
  /// Buoc lien sau, theo cot "Trạng thái sau".
  sau        String?
  /// "Sale" | "Nhiếp ảnh" — ai lo buoc nay.
  trachNhiem String?
  moTa       String?
  taoLuc     DateTime @default(now())

  @@index([thuTu])
}

/// TAI LIEU — bang "Tài liệu" ben AppSheet (7 dong).
///
/// Bay dong deu la video YouTube huong dan dung CHINH APP APPSHEET. Chep sang
/// day de khong bo sot bang nao, nhung xem KE-HOACH-CRM.md doi 6: chung se
/// thanh vo nghia ngay chuyen han, va cho cua tai lieu huong dan web la
/// `docs/huong-dan-admin.html`.
model TaiLieu {
  id               String    @id @default(cuid())
  maAppSheet       String?   @unique
  /// "HDSD0101"…
  maTaiLieu        String?
  phongBan         String?
  loai             String?
  ten              String
  lanBanHanh       Int       @default(1)
  ngayBanHanh      String?
  /// Anh bia, dia chi tren Drive cua AppSheet.
  anhAppSheet      String?
  /// Dia chi video hoac tep.
  link             String?
  phanPhoi         String?
  ghiChu           String?
  /// "Hiện hành" | da thay the.
  tinhTrang        String?
  ngayCapNhat      String?
  nguoiCapNhatMaNV String?
  taoLuc           DateTime  @default(now())
  bamAppSheet      String?
  matBenAppSheet   DateTime?
}

/// SO SU CO — bang "Log" ben AppSheet (22 dong).
///
/// Ba cot "Xử lý", "Thời gian tạo", "Thời gian xử lý" RONG HOAN TOAN ca 22
/// dong, va chi 13/22 co noi van de gi. Nghia la khong dong nao biet minh xay
/// ra luc nao. Chep de giu lai, nhung so nay chi thuc su song khi ghi tren web
/// — luc do `taoLuc` va `xongLuc` moi co that.
model SuCo {
  id             String    @id @default(cuid())
  maAppSheet     String?   @unique
  /// Chuyen gi xay ra.
  vanDe          String?
  /// Chi tiet them.
  thongTin       String?
  /// "Đang tạo" | "Đã xong".
  trangThai      String?
  /// Da lam gi de xu ly.
  xuLy           String?
  /// Ma nhan vien ghi so.
  nguoiGhiMaNV   String?
  taoLuc         DateTime  @default(now())
  xongLuc        DateTime?
  bamAppSheet    String?
  matBenAppSheet DateTime?

  @@index([trangThai])
}
